---
- name: Update, Upgrade, Install Packages, and Start QEMU Agent
  hosts: all
  remote_user: root

  tasks:
    - name: Update apt cache
      apt:
        update_cache: yes

    - name: Upgrade all packages
      apt:
        upgrade: safe
        autoremove: yes
        force_apt_get: yes

    - name: Install required packages
      apt:
        name:
          - git
          - wget
          - curl
          - unzip
          - htop
          - python3
          - python3-pip
          - nfs-common
          - prometheus-node-exporter
          - rkhunter
          - clamav-daemon
          - clamav
          - qemu-guest-agent
        state: present
        update_cache: yes
        autoremove: yes
        force_apt_get: yes
      notify:
        - Start and enable services

  handlers:
    - name: Start and enable services
      systemd:
        name: "{{ item }}"
        state: started
        enabled: yes
      loop:
        - clamav-daemon
        - prometheus-node-exporter

    - name: Reboot the system
      reboot:
        msg: "Rebooting the system..."

- name: Ensure SSH known_hosts files exist
  hosts: all
  remote_user: root

  tasks:
    # /etc/ssh and the global ssh_known_hosts must stay world-readable: every user's
    # ssh client reads them (Debian/Ubuntu ship 0755 / 0644). Only ~/.ssh is 0700.
    - name: Ensure SSH directories and files exist
      ansible.builtin.file:
        path: "{{ item.path }}"
        state: "{{ item.state }}"
        mode: "{{ item.mode }}"
        access_time: "{{ 'preserve' if item.state == 'touch' else omit }}"
        modification_time: "{{ 'preserve' if item.state == 'touch' else omit }}"
      loop:
        - { path: /home/ansible/.ssh, state: directory, mode: "0700" }
        - { path: /root/.ssh, state: directory, mode: "0700" }
        - { path: /etc/ssh, state: directory, mode: "0755" }
        - { path: /etc/ssh/ssh_known_hosts, state: touch, mode: "0644" }
      tags:
        - ssh_known_hosts
