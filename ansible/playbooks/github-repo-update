---
# Clone each repository, or fast-forward it if it is already there.
# Private repos: use an SSH url (git@github.com:USER/REPO.git) with a deploy key on the
# host, not a password prompt. GitHub no longer accepts account passwords for git.
- name: Configure and Update Git Repositories
  hosts: all
  remote_user: root

  vars:
    repositories:
      - name: repository1
        url: https://github.com/USERNAME/repository1.git
        path: /path/to/repository1
      - name: repository2
        url: https://github.com/USERNAME/repository2.git
        path: /path/to/repository2
        branch: main
      # Add more repositories as needed (branch defaults to main)

  tasks:
    - name: Ensure the parent directories exist
      ansible.builtin.file:
        path: "{{ repo_item.path | dirname }}"
        state: directory
        mode: "0755"
      loop: "{{ repositories }}"
      loop_control:
        loop_var: repo_item

    - name: Clone or fast-forward each repository
      ansible.builtin.git:
        repo: "{{ repo_item.url }}"
        dest: "{{ repo_item.path }}"
        version: "{{ repo_item.branch | default('main') }}"
        update: true
      loop: "{{ repositories }}"
      loop_control:
        loop_var: repo_item
        label: "{{ repo_item.name }}"
